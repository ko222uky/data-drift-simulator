# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -base64 36

# ---- Public address ---------------------------------------------------------
# Local development (plain HTTP on http://localhost):
PUBLIC_HOST=localhost
PUBLIC_ORIGIN=http://localhost
COOKIE_SECURE=false
# Droplet: the kloworld-edge proxy serves HTTPS for the hostname and forwards to the
# gateway over the shared `edge` network, which compose.edge.yml attaches it to.
# PUBLIC_HOST=datadrift.example.com
# PUBLIC_ORIGIN=https://datadrift.example.com
# COOKIE_SECURE=true
# COMPOSE_FILE=docker-compose.yml:compose.edge.yml

# Gateway port, bound to 127.0.0.1. Change it if 80 is taken locally; on the droplet use
# 8001, since the edge proxy owns port 80 there.
HTTP_PORT=80

# ---- Operator login -----------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# At least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# ---- Database ---------------------------------------------------------------------
POSTGRES_USER=mlops
POSTGRES_PASSWORD=change-me

# ---- Simulation -------------------------------------------------------------------
# Seconds per interval at start-up (also adjustable live from the dashboard).
MODEL_INTERVAL_SECONDS=5
