# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -base64 36

# ---- Public address ---------------------------------------------------------
# Local development (plain HTTP on http://localhost):
SITE_ADDRESS=http://localhost
PUBLIC_HOST=localhost
PUBLIC_ORIGIN=http://localhost
COOKIE_SECURE=false
# Droplet with a domain (automatic HTTPS). No domain? Use <ip-with-dashes>.sslip.io,
# e.g. 203-0-113-10.sslip.io, which resolves to your droplet's IP.
# SITE_ADDRESS=demo.example.com
# PUBLIC_HOST=demo.example.com
# PUBLIC_ORIGIN=https://demo.example.com
# COOKIE_SECURE=true

# Host ports for the gateway (change HTTP_PORT if 80 is taken locally).
HTTP_PORT=80
HTTPS_PORT=443

# ---- Operator login -----------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# At least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# ---- Database ---------------------------------------------------------------------
POSTGRES_USER=mlops
POSTGRES_PASSWORD=change-me

# ---- Simulation -------------------------------------------------------------------
# Seconds per interval at start-up (also adjustable live from the dashboard).
MODEL_INTERVAL_SECONDS=5
