# API gateway: the app's single entry point. Plain HTTP on :80, for any hostname.
#
# On the droplet, HTTPS is terminated in front of this container by the kloworld-edge proxy
# (github.com/ko222uky/kloworld-edge), which reaches it over the shared `edge` Docker
# network as datadrift-gateway:80. Locally, docker compose publishes it on http://localhost.
#
# Routes:
#   /api/auth/*   -> auth service      (public: login / logout / me)
#   /api/model/*  -> model service     (GET public; anything else requires a session)
#   /mlflow/*     -> MLflow UI + API   (requires a session; redirects to /login)
#   everything else -> Next.js frontend
#
# Upstreams default to the docker compose service names; the *_UPSTREAM variables
# exist so the same file can front services running directly on the host, and SITE_ADDRESS
# (default :80) lets that host-run Caddy listen elsewhere, e.g. http://localhost:8088.

{
	servers {
		# Requests arrive from the edge proxy (or Docker's port forwarding), both on private
		# addresses. Trusting them keeps the real client in X-Forwarded-For (the auth service
		# throttles logins per client) and the original https in X-Forwarded-Proto. The edge
		# proxy trusts no one and overwrites what clients send, so neither can be spoofed.
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	request_body {
		max_size 1MB
	}

	# ---- auth service --------------------------------------------------------
	# /verify is the internal forward-auth hook; never expose it.
	handle /api/auth/verify {
		respond 404
	}
	handle_path /api/auth/* {
		reverse_proxy {$AUTH_UPSTREAM:auth:8000}
	}

	# ---- model service -------------------------------------------------------
	@model_write {
		path /api/model/*
		not method GET HEAD
	}
	handle @model_write {
		forward_auth {$AUTH_UPSTREAM:auth:8000} {
			uri /verify
			copy_headers X-Auth-User
		}
		uri strip_prefix /api/model
		reverse_proxy {$MODEL_UPSTREAM:model:8000}
	}
	handle_path /api/model/* {
		reverse_proxy {$MODEL_UPSTREAM:model:8000}
	}

	# ---- MLflow (served under the /mlflow static prefix) ---------------------
	handle /mlflow* {
		forward_auth {$AUTH_UPSTREAM:auth:8000} {
			uri /verify
			@unauthorized status 401
			handle_response @unauthorized {
				redir * /login?next=/mlflow/ 302
			}
		}
		reverse_proxy {$MLFLOW_UPSTREAM:mlflow:5000}
	}

	# ---- frontend ------------------------------------------------------------
	handle {
		reverse_proxy {$FRONTEND_UPSTREAM:frontend:3000}
	}
}
